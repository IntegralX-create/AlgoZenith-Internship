#include<bits/stdc++.h>
using namespace std;

int n,k;
int ans;
int board[14][14];

int dx[]={1,2,2,1,-1,-2,-2,-1};
int dy[]={2,1,-1,-2,-2,-1,1,2};

bool check(int i,int j){
    if(board[i][j]==1)return 0;
    for(int pos=0;pos<8;pos++){
        int nx=i+dx[pos];
        int ny=j+dy[pos];

        if(nx<n and nx >=0 and ny<n and ny>=0 
            and board[nx][ny]==1)return 0;
    }
    return 1;
}



void rect(int level,int lastx , int lasty){
    if(level==k){
        ans++;
        return;
    }

    for(int i=lastx;i<n;i++){
        for(int j=0;j<n;j++){
            if(i==lastx and j<=lasty)continue;
            if(check(i,j)==1){
                board[i][j]=1;
                rect(level+1,i,j);
                board[i][j]=0;
            }
            
        }
    }

}


void solve(){
    cin >> n >> k;
    ans=0;
    rect(0,0,-1);
    //for(int i=1;i<=k;i++)ans/=i;
    cout << ans << endl;

}

int main(){
    int T = 1;
    //cin >> T;

    while(T--)
        solve();

    return 0;
}
